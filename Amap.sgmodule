#!name=高德地图去广告·开屏保守版
#!desc=仅针对已知开屏广告接口返回空 JSON；不处理首页推荐或搜索内容。需 Surge iOS 5.9.1+，开启重写与 MITM，并信任自己的 CA 证书。未经真机验证。

# 版本：0.1.0；编写日期：2026-10-23
# 适用目标：中国版高德地图 iOS；具体 App 版本兼容性待验证。
# 接口依据：Repcz/Tool 的 Kelee 转换模块（上游标注：可莉）。
# https://github.com/Repcz/Tool/blob/X/Surge/Module/Kelee/Amap_remove_ads.sgmodule
# 本文件仅保留开屏接口映射，不包含上游的页面精简或 Body Rewrite。
# 本地响应不含业务成功字段，是否被特定版本接受需实际验证。

[Map Local]
(?i)^https://m5\.amap\.com/ws/valueadded/alimama/splash_screen\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
# 追加而非覆盖现有主机名；不包含 CA、不关闭服务端证书验证。
# 解密按主机名生效，因此该主机的非广告 HTTPS 请求也在解密范围内。
hostname = %APPEND% m5.amap.com
