#!name=高德地图去广告·开屏与打车活动
#!desc=v0.3.0：保留开屏规则，新增打车领券/活动弹窗列表过滤；保留订单、付款、安全和协议提醒。需 Surge iOS 5.9.1+、重写、脚本和已信任的 MITM；实际效果待真机验证。请停用重复模块。

# 编写日期：2026-10-23
# 本地 HAR 的 User-Agent 中观察到 AMap 17.02.0；不表示全版本适用。
# 新接口的真实响应是 multipart/form-data：JSON 广告元数据 + JPEG 素材，
# 其中 creative.media.is_ad="1"，display_time="5"。
# 本版拒绝该独立接口，不把它强制改成 {} 或 204，不处理整个域名。
# 客户端如何处理拒绝（跳过、重试、留白或回退）尚待用户真机测试。

[URL Rewrite]
(?i)^https://amap-aos-info-nogw\.amap\.com/ws/aos/alimama/splash_screen_rt(?:\?|$) _ reject

[Map Local]
# 保留 v0.1 的旧接口规则；在本次 HAR 中未出现，不等于永远不再使用。
# 旧接口依据：https://github.com/Repcz/Tool/blob/X/Surge/Module/Kelee/Amap_remove_ads.sgmodule
(?i)^https://m5\.amap\.com/ws/valueadded/alimama/splash_screen\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 只处理促销 resource 的已知弹窗列表，不拦截整个打车接口。
# 源码固定到已核对的 GitHub 提交，后续更新不漂移。
# 异常/未知结构保留原响应；响应超过 256 KiB 由 Surge 跳过脚本透传。
amap-taxi-promo-popup = type=http-response,pattern=(?i)^https://m5-zb\.amap\.com/ws/promotion-web/resource(?:\?|$),requires-body=true,max-size=262144,timeout=5,script-path=https://raw.githubusercontent.com/niu93/surge-modules/3eb0734a3c528df53c0837145de146ed918a3e89/amap-taxi-popup.js

[MITM]
# 追加三个必要主机；m5-zb.amap.com 用于打车促销响应处理。不替换 CA、不关闭服务端证书验证。
# MITM 会覆盖这些主机上的其他 HTTPS 请求，并非仅广告路径。
hostname = %APPEND% m5.amap.com, amap-aos-info-nogw.amap.com, m5-zb.amap.com
