#!name=拼多多精简（v0.4.9）
#!desc=版本 0.4.9：根据 8.33.0 IPA 模型处理 bottomTabs/bufferBottomTabs 刷新字段，防止客户端恢复额外底栏。固定链接持续更新。

[Script]
PDD-Bottom-Tabs = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub(?:\?|$),requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/niu93/surge-modules/main/surge/%E5%8E%BB%E5%B9%BF%E5%91%8A/%E6%8B%BC%E5%A4%9A%E5%A4%9A/pdd-bottom-tabs-v030.js?v=0.4.9
PDD-Homepage-Config = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/config\/hub(?:\?|$),requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/niu93/surge-modules/main/surge/%E5%8E%BB%E5%B9%BF%E5%91%8A/%E6%8B%BC%E5%A4%9A%E5%A4%9A/pdd-bottom-tabs-v030.js?v=0.4.9
PDD-Chat-Goods = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/alexa\/cells\/hub\/v3\?.*scene=homegoods_dy_tpl.*,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/niu93/surge-modules/main/surge/%E5%8E%BB%E5%B9%BF%E5%91%8A/%E6%8B%BC%E5%A4%9A%E5%A4%9A/pdd-chat-goods.js?v=0.4.9

[MITM]
hostname = %APPEND% api.pinduoduo.com
