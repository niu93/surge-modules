#!name=拼多多底栏精简（三栏·测试版）
#!desc=仅保留首页、聊天、个人中心，过滤其他服务端底栏。基于 iOS 8.29.0 抓包，尚未实机验证；样本已仅含三栏，不承诺清除本地缓存或其他接口入口。需启用 MITM 并信任证书。

[Script]
pdd-bottom-tabs = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub(?:\?|$),requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/niu93/surge-modules/main/surge/%E5%8E%BB%E5%B9%BF%E5%91%8A/%E6%8B%BC%E5%A4%9A%E5%A4%9A/pdd-bottom-tabs.js

[MITM]
hostname = %APPEND% api.pinduoduo.com
