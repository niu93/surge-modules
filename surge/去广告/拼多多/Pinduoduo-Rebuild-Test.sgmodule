#!name=拼多多·开屏与底栏重建测试
#!desc=v0.2.7-test10：撤销无效底栏皮肤实验，恢复开屏/双数组过滤两条规则；当前五项界面问题尚未修复。
#!author=底栏参考 ZenmoFeiShi、可莉原插件；Surge本地适配
#!source-url=https://kelee.one/Tool/Loon/Lpx/PinDuoDuo_remove_ads.lpx
#!requirement=CORE_VERSION>=20

# 根据用户要求重新启用底栏实际过滤；不是已解决原生界面五项问题的保证。
# 原生jq需iOS5.14+/Mac5.9+；CORE_VERSION>=20仅为通用Body Rewrite门槛。
# 保留原开屏jq不变；底栏按原作者完整link白名单，同时处理bottom_tabs和buffer_bottom_tabs。
# 不包含原all_top_opts图片删除、不改顶部分类/首页商品/订单/个人页，不封域名、不加远程JS。
# 底栏入口链接必须等于三个已见文件名；未知链接会按原作者白名单排除。
# 对根节点和数组增加类型保护；解析异常或非预期类型保留原响应。

[Body Rewrite]
http-response-jq (?i)^https://api\.pinduoduo\.com/api/cappuccino/splash(?:\?|$) '. as $original | try (if (type == "object" and (.splash_list | type) == "array" and (.size | type) == "number" and (.valid_splash_id | type) == "number" and (.valid_splash_source_type | type) == "number") then .splash_list = [] | .size = 0 | .valid_splash_id = 0 | .valid_splash_source_type = 0 else . end) catch $original'
http-response-jq (?i)^https://api\.pinduoduo\.com/api/alexa/homepage/hub(?:\?|$) '. as $original | try (if (type == "object" and (.result | type) == "object") then (if (.result.bottom_tabs | type) == "array" then .result.bottom_tabs |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) else . end) | (if (.result.buffer_bottom_tabs | type) == "array" then .result.buffer_bottom_tabs |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) else . end) else . end) catch $original'

[MITM]
hostname = %APPEND% api.pinduoduo.com
