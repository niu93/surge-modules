http-response-jq (?i)^https://m5\.amap\.com/ws/info_bff/ContentCenter(?:\?|$) '. as $original | try (def object: type == "object"; def target_tab: if object then .key as $key | (["explore_page_tab_rec_focusOn", "explore_page_tab_rec_city", "explore_page_tab_rec_nearBy", "explore_page_tab_rec_travel", "explore_page_tab_rec_food", "explore_page_tab_rec_shopping"] | index($key)) != null else false end; if (object and (.data | object) and (.data.modules | object)) then if (.data.modules.header | object) then if (.data.modules.header.card_id == "HeaderTab" and (.data.modules.header.data | object)) then if (.data.modules.header.data.list | type) == "array" then .data.modules.header.data.list as $before | ($before | map(select(target_tab | not))) as $after | if ($after | length) < ($before | length) or ($before | length) == 0 then if ($after | length) == 0 then del(.data.modules.header) | if (.data.regions | object) then .data.regions |= with_entries( if (.value | type) == "array" then .value |= map(select(. != "header")) else . end ) else . end else .data.modules.header.data.list = $after end else . end else . end else . end else . end else . end) catch $original'

http-response-jq (?i)^https://m5\.amap\.com/ws/shield/frogserver/aocs/updatable/1(?:\?|$) '. as $original | try (if (.data | type) == "object" then del(.data.adCustomerRetainArchitecture, .data.marketing_resource_config, .data.taxi_activity, .data.tel_retention_popup) else . end) catch $original'

[Script]
